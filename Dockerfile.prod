# ============================================
# Build stage
# ============================================
FROM node:22-bookworm AS build

WORKDIR /app

# Copy dependency files first for Docker layer caching
COPY package.json package-lock.json ./

# Install dependencies exactly as in package-lock.json
RUN npm ci --ignore-scripts

# Copy application source
COPY . .

# Build Next.js static export bundle
RUN npm run build


# ============================================
# Runtime stage
# ============================================
FROM nginx:1.27-alpine

# Required by the Docker / Coolify healthcheck probe
RUN apk add --no-cache curl

# Nginx configuration with SPA routing & fast healthcheck
COPY docker/nginx.prod.conf /etc/nginx/conf.d/default.conf

# Copy Next.js static export bundle to Nginx html root
COPY --from=build /app/out /usr/share/nginx/html

EXPOSE 80

# Container healthcheck for Coolify / Docker
HEALTHCHECK \
    --interval=15s \
    --timeout=5s \
    --start-period=15s \
    --retries=3 \
    CMD curl -f http://127.0.0.1/healthcheck || curl -f http://127.0.0.1/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
